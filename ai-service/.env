# ====== 数据库配置 ======
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chaowan_platform
DB_USER=root
DB_PASSWORD=sql2008

# ====== 智谱AI ChatGLM 配置 ======
# 申请地址: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=daa5e2be7fba497c991aafae2964a6bd.RTt1AcPjSQSOYYPB
# 模型名: glm-4 / glm-4-flash / glm-4-plus / glm-4-long
ZHIPU_MODEL=glm-4.7-flash
# 调用超时(秒) - 知识库检索可能耗时较长，建议60秒以上
ZHIPU_TIMEOUT=60
# 知识库ID - 在智谱开放平台「知识库管理」中获取
ZHIPU_KNOWLEDGE_BASE_ID=2076583801819222016
# 触发大模型的最低置信度阈值(0~1)，FAQ最高分/阈值时直接走本地
FAQ_CONFIDENCE_THRESHOLD=0.35

# ====== 服务配置 ======
AI_SERVICE_PORT=8089
# 是否在FAQ命中后仍然调用大模型润色(为节省Token，默认False)
FAQ_POLISH_WITH_LLM=false
# RAG检索最近订单数量
RAG_RECENT_ORDER_LIMIT=3
# RAG检索相关商品数量
RAG_PRODUCT_LIMIT=5
